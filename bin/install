#! /bin/zsh -f

set -o errexit -o pipefail

ROOT="${0:A:h}"
NIX=(
  neovim=nvim
  tmux
  fzf
  go
  git
  git-lfs
  pi-coding-agent=pi
  herdr
  ripgrep=rg
  fd
  zoxide
  tree
)

main() {
  if ! command -v nix &>/dev/null; then
    >&2 echo "> nix isn't installed, please install it"
    exit 2
  fi
  for tool in "${NIX[@]}"; do
    if ! "$ROOT"/tool-exists "$tool" &>/dev/null; then
      "$ROOT"/nix-install "$tool"
    fi
  done
  "$ROOT"/install-user ~/.local/dotfiles
}

main
